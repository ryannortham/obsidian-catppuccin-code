{
  "name": "obsidian-catppuccin-code",
  "version": "1.0.0",
  "description": "Catppuccin for Obsidian, reworked to match Catppuccin for VS Code.",
  "scripts": {
    "build": "sass scss/main.scss:dist/catppuccin.css",
    "build:theme": "sass scss/main.scss:theme.css",
    "lint": "stylelint scss/base/_semantic-roles.scss scss/components/_cmd-palette.scss scss/components/_inputs.scss scss/components/_links.scss scss/components/_search.scss scss/components/_syntax.scss scss/layout/_interface.scss scss/pages/_settings.scss scss/themes/_document-palette.scss scss/vendors/_plugin-compatibility.scss scss/vendors/_plugins.scss",
    "test": "node tests/theme-contract.mjs && node tests/markdown-contract.mjs",
    "test:visual": "node tests/render-interface-fixture.mjs",
    "test:visual:check": "node tests/render-interface-fixture.mjs --check",
    "test:visual:markdown": "node tests/render-markdown-fixture.mjs",
    "test:visual:markdown:check": "node tests/render-markdown-fixture.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryannortham/obsidian-catppuccin-code.git"
  },
  "keywords": [
    "catppuccin",
    "obsidian",
    "theme"
  ],
  "author": "Ryan Northam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ryannortham/obsidian-catppuccin-code/issues"
  },
  "homepage": "https://github.com/ryannortham/obsidian-catppuccin-code#readme",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=10.11.0"
  },
  "dependencies": {
    "sass": "^1.80.6"
  },
  "devDependencies": {
    "stylelint": "^17.0.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^2.8.0",
    "stylelint-order": "^7.0.0"
  }
}
